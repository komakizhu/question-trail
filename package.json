{
  "name": "obsidian-exam-notes",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "description": "Obsidian plugin for public-exam question callouts",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:obsidian": "node tests/run-callout-fold-runtime.mjs",
